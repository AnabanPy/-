/* Светлая тема */
QMainWindow {
    background-color: #f5f7fa;
}

QWidget {
    background-color: #f5f7fa;
}

/* Вкладки */
QTabWidget::pane {
    background-color: #ffffff;
    border: 1px solid #e0e4e8;
    border-radius: 10px;
}

QTabBar::tab {
    background-color: #e9ecef;
    color: #495057;
    padding: 12px 28px;
    margin-right: 4px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    font-size: 13px;
    font-weight: 500;
}

QTabBar::tab:selected {
    background-color: #ffffff;
    color: #0066cc;
    border-bottom: 2px solid #0066cc;
}

QTabBar::tab:hover:!selected {
    background-color: #dee2e6;
}

/* Кнопки */
QPushButton {
    background-color: #0066cc;
    color: white;
    border: none;
    padding: 10px 24px;
    border-radius: 8px;
    font-weight: 500;
    font-size: 13px;
}

QPushButton:hover {
    background-color: #0052a3;
}

QPushButton:pressed {
    background-color: #003d80;
}

QPushButton#secondary {
    background-color: #e9ecef;
    color: #495057;
}

QPushButton#secondary:hover {
    background-color: #dee2e6;
}

/* Поля ввода */
QLineEdit, QComboBox, QDateEdit {
    background-color: #ffffff;
    border: 1px solid #ced4da;
    border-radius: 8px;
    padding: 10px 14px;
    color: #212529;
    font-size: 13px;
    min-height: 24px;
}

QLineEdit:focus, QComboBox:focus {
    border-color: #0066cc;
    outline: none;
}

/* ТАБЛИЦЫ — увеличенный шрифт */
QTableWidget {
    background-color: #ffffff;
    alternate-background-color: #f8f9fa;
    gridline-color: #e0e4e8;
    selection-background-color: #e3f2fd;
    selection-color: #0066cc;
    border: 1px solid #e0e4e8;
    border-radius: 10px;
    font-size: 12pt;
}

QTableWidget::item {
    padding: 12px 8px;
    font-size: 12pt;
}

QHeaderView::section {
    background-color: #f8f9fa;
    color: #495057;
    padding: 14px;
    border: none;
    border-bottom: 1px solid #e0e4e8;
    font-weight: 600;
    font-size: 13pt;
}

/* Списки */
QListWidget {
    background-color: #ffffff;
    border: 1px solid #ced4da;
    border-radius: 8px;
    color: #212529;
    padding: 4px;
    font-size: 12pt;
}

QListWidget::item {
    padding: 10px 14px;
    border-radius: 6px;
}

QListWidget::item:selected {
    background-color: #e3f2fd;
    color: #0066cc;
}

QListWidget::item:hover {
    background-color: #f0f4f8;
}

/* Групповые боксы */
QGroupBox {
    border: 1px solid #e0e4e8;
    border-radius: 12px;
    margin-top: 16px;
    padding-top: 16px;
    font-weight: 600;
    background-color: #ffffff;
    font-size: 12pt;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 16px;
    padding: 0 10px;
    color: #212529;
}

/* Label */
QLabel {
    color: #495057;
    font-size: 12pt;
}

QLabel#title {
    font-size: 20px;
    font-weight: 600;
    color: #212529;
}

QLabel#subtitle {
    font-size: 12pt;
    color: #6c757d;
}

/* Диалоги */
QDialog {
    background-color: #f5f7fa;
}

QDialog QLabel {
    font-size: 12pt;
}

QDialog QLineEdit {
    font-size: 12pt;
}

QDialog QPushButton {
    font-size: 12pt;
}